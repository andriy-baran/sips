.list-group-item
  .row.d-flex.align-items-center
    .col-4.col-md-5.col-lg-7
      label.col-form-label[for=""]
        = stock.product.title
    .col-5.col-md-5.col-lg-3
      span.d-block.d-sm-none
        = stock.weight_kilogram
        | &#032;
        | кг
      span.d-none.d-sm-block
        = stock.weight_kilogram
        | &#032;
        | кілограми
    .col-sm-3.col-md-2.col-3
      .d-block.d-sm-none
        = button_tag type: 'submit', class: "btn btn-warning" do
          i.fa.fa-pencil-square-o
      .d-none.d-sm-block
        = link_to 'Змінити', edit_trade_point_of_sale_checkout_path(point_of_sale, stock), class: 'btn btn-warning edit-checkout', remote: true
