<p id="notice"><%= notice %></p>

<h1>Manage Point Of Sales</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @point_of_sales.each do |point_of_sale| %>
      <tr>
        <td><%= point_of_sale.title %></td>
        <td><%= point_of_sale.place.city %></td>
        <td><%= point_of_sale.place.address %></td>
        <td><%= link_to 'Show', [:manage, point_of_sale] %></td>
        <td><%= link_to 'Edit', edit_manage_point_of_sale_path(point_of_sale) %></td>
        <td><%= link_to 'Destroy', [:manage, point_of_sale], method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Manage Point Of Sale', new_manage_point_of_sale_path %>
