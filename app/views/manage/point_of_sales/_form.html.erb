<%= form_with(model: [:manage, point_of_sale], local: true) do |form| %>
  <% if point_of_sale.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(point_of_sale.errors.count, "error") %> prohibited this point_of_sale from being saved:</h2>

      <ul>
      <% point_of_sale.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Назва Точки</label>
    <div class="col-8">
      <%= form.text_field :title, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Місто</label>
    <div class="col-8">
      <%= form.text_field :city, value: form.object.persisted? ? form.object.place.city : nil, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Адреса</label>
    <div class="col-8">
      <%= form.text_field :address, value: form.object.persisted? ? form.object.place.address : nil, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <div class="offset-4 col-8">
      <%= form.submit 'Зберегти', class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
