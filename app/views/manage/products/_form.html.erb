<%= form_with(model: [:manage, @product], local: true) do |form| %>
  <% if @product.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@product.errors.count, "error") %> prohibited this product from being saved:</h2>

      <ul>
      <% @product.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Назва Продукту</label>
    <div class="col-8">
      <%= form.text_field :title, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Вага порції</label>
    <div class="col-8">
      <%= form.text_field :weight, value: form.object.persisted? ? form.object.variant.weight : nil, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <label for="" class="col-4 col-form-label">Ціна порції</label>
    <div class="col-8">
      <%= form.text_field :price, value: form.object.persisted? ? form.object.variant.price : nil, required: "required", class: "form-control here" %>
    </div>
  </div>
  <div class="form-group row">
    <div class="offset-4 col-8">
      <%= form.submit 'Зберегти', class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
