<p id="notice"><%= notice %></p>

<h1>Manage Products</h1>

<table>
  <thead>
    <tr>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.title %></td>
        <td><%= product.variant.weight %></td>
        <td><%= product.variant.price %></td>
        <td><%= link_to 'Show', [:manage, product] %></td>
        <td><%= link_to 'Edit', edit_manage_product_path(product) %></td>
        <td><%= link_to 'Destroy', [:manage, product], method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Manage Product', new_manage_product_path %>
