p#notice
  = notice
h1
  | Manage Point Of Sales
table.table
  thead
    tr
      th Ім'я
      th Телефон
      th[colspan="3"] Дії
  tbody
    - @accounts.each do |account|
      tr
        td
          = account.full_name
        td
          = account.phone
        td
          = link_to 'Show', [:manage, account], class: 'btn btn-info btn-sm'
        td
          = link_to 'Edit', edit_manage_account_path(account), class: 'btn btn-warning btn-sm'
        td
          = link_to 'Destroy', [:manage, account], method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm'
br
/ = link_to 'Додати Точку Продажу', new_manage_point_of_sale_path, class: 'btn btn-success'
